# Configuration de secretsanta : toutes les variables d'environnement.
# Les lignes actives sont obligatoires ; les lignes commentées (#) sont
# facultatives et montrent leur valeur par défaut ou un exemple.

# --- Instance ---------------------------------------------------------------
# Adresse publique de l'application (liens dans les courriels).
# PUBLIC_URL=http://localhost:8080
# Adresse d'écoute du serveur HTTP.
# LISTEN_ADDR=:8080
# Dossier des données (base SQLite), à monter en volume.
# DATA_DIR=/data
# Fuseau horaire (nom IANA) : fenêtre d'envoi des relances, affichage des dates.
# APP_TIMEZONE=Europe/Paris

# --- Secrets obligatoires (aucun défaut : l'application refuse de démarrer sans) ---
# Mot de passe d'instance demandé pour créer un groupe.
INSTANCE_PASSWORD=
# Secret de signature (liens signés, désinscription). Longue valeur aléatoire.
SIGNING_SECRET=

# --- Courrier SMTP (facultatif : sans SMTP_HOST, l'envoi est désactivé) -----
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Adresse d'expédition (obligatoire dès que SMTP_HOST est défini).
# MAIL_FROM=noel@example.org
# MAIL_FROM_NAME=Père Noël secret

# --- Délivrabilité ----------------------------------------------------------
# Nom d'hôte annoncé à EHLO : nom de domaine plein ou adresse entre crochets.
# MAIL_EHLO_HOSTNAME=mail.example.org
# Expéditeur d'enveloppe (défaut : MAIL_FROM).
# MAIL_ENVELOPE_FROM=bounce@example.org
# Adresse de réponse (facultatif).
# MAIL_REPLY_TO=
# Chiffrement : starttls (défaut), tls (implicite) ou none.
# MAIL_TLS_MODE=starttls
# Le mode none n'est accepté que si cette variable vaut true.
# MAIL_ALLOW_INSECURE=false
# Débit maximal d'envois par minute.
# MAIL_MAX_PER_MINUTE=30

# --- Signature DKIM par l'application (facultatif, tout ou rien) -------------
# La clé privée se place dans un fichier ; jamais en clair dans une variable.
# MAIL_DKIM_DOMAIN=example.org
# MAIL_DKIM_SELECTOR=noel
# MAIL_DKIM_KEY_FILE=/run/secrets/dkim.pem
# rsa-sha256 ou ed25519-sha256
# MAIL_DKIM_ALGORITHM=rsa-sha256
# En-têtes signés, séparés par des virgules (défaut ci-dessous).
# MAIL_DKIM_HEADERS=From,To,Subject,Date,Message-ID,Reply-To,MIME-Version,Content-Type,List-Unsubscribe,List-Unsubscribe-Post

# --- Relances ---------------------------------------------------------------
# Interrupteur général des relances automatiques.
# REMINDERS_ENABLED=true

# --- Sources de suggestions (facultatif ; le catalogue embarqué sert de secours) ---
# SearXNG auto-hébergé (prioritaire).
# SEARXNG_URL=http://searxng:8080
# BRAVE_API_KEY=
# SERPER_API_KEY=
